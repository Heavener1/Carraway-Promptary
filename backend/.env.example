# Copy to .env and adjust. Run uvicorn from the backend/ directory.
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev-secret-change-me-please-use-32-bytes-min
DATABASE_URL=sqlite+aiosqlite:///./promptary.db
AUTO_CREATE_TABLES=true

# CORS must be a JSON array.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# local = files stored under MEDIA_ROOT (development default)
# s3    = S3/MinIO presigned uploads (wire up when deploying)
STORAGE_BACKEND=local
MEDIA_ROOT=./media
MAX_IMAGE_MB=12
MAX_VIDEO_MB=80

# Development admin account, created on startup when missing.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456
SEED_ADMIN=true

# Production cookie settings
COOKIE_SECURE=false
